<?xml version="1.0" encoding="utf-8"?>
<!-- Artwork and the Image Bank are backed up to the user's Google account and moved to new devices. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="projects/" />
        <include domain="file" path="bank/" />
        <include domain="file" path="brush_tips/" />
        <include domain="file" path="custom_brushes.bin" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
